<%- include('../partials/head') %>
<%- include('../partials/header', { headerTransparent: true }) %>

<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <span class="hero-eyebrow"><%- include('../partials/icons', { icon: 'shield' }) %> Atendimento personalizado e sem burocracia</span>
    <h1><%= settings.hero_title %></h1>
    <p><%= settings.hero_subtitle %></p>

    <form class="search-box" action="/imoveis" method="get">
      <div class="search-field">
        <label for="s-tipo">Tipo</label>
        <select id="s-tipo" name="tipo">
          <option value="">Todos os tipos</option>
          <% for (const t of types) { %><option value="<%= t.value %>"><%= t.label %></option><% } %>
        </select>
      </div>
      <div class="search-field">
        <label for="s-cidade">Cidade</label>
        <select id="s-cidade" name="cidade">
          <option value="">Todas as cidades</option>
          <% for (const c of filters.cities) { %><option value="<%= c.city %>"><%= c.city %></option><% } %>
        </select>
      </div>
      <div class="search-field">
        <label for="s-quartos">Dormitórios</label>
        <select id="s-quartos" name="quartos">
          <option value="">Qualquer</option>
          <option value="1">1+</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option>
        </select>
      </div>
      <div class="search-field">
        <label for="s-max">Até (R$/mês)</label>
        <input id="s-max" name="max" type="text" inputmode="numeric" placeholder="Ex.: 3.500" data-money>
      </div>
      <button class="btn btn-accent btn-lg" type="submit"><%- include('../partials/icons', { icon: 'search' }) %> Buscar</button>
    </form>

    <div class="hero-stats">
      <div><strong><%= stats.available %></strong><span>imóveis disponíveis</span></div>
      <div><strong><%= stats.cities %></strong><span>cidades atendidas</span></div>
      <div><strong><%= stats.rented %></strong><span>imóveis já alugados</span></div>
    </div>
  </div>
</section>

<% if (featured.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="section-eyebrow">Selecionados para você</span>
        <h2>Imóveis em destaque</h2>
      </div>
      <a href="/imoveis" class="btn btn-outline">Ver todos <%- include('../partials/icons', { icon: 'arrow' }) %></a>
    </div>
    <div class="prop-grid">
      <% for (const p of featured) { %><%- include('../partials/property-card', { p }) %><% } %>
    </div>
  </div>
</section>
<% } %>

<section class="section section-alt">
  <div class="container">
    <div class="section-head center">
      <span class="section-eyebrow">Explore por categoria</span>
      <h2>O que você procura?</h2>
    </div>
    <div class="type-grid">
      <% const typeIcons = { casa: 'home', apartamento: 'building', sobrado: 'home', kitnet: 'key', cobertura: 'building', comercial: 'tag', galpao: 'grid', terreno: 'area' }; %>
      <% for (const t of types.filter(t => t.count > 0)) { %>
      <a href="/imoveis?tipo=<%= t.value %>" class="type-card">
        <span class="type-icon"><%- include('../partials/icons', { icon: typeIcons[t.value] || 'home' }) %></span>
        <strong><%= t.label %></strong>
        <span><%= t.count %> <%= t.count === 1 ? 'imóvel' : 'imóveis' %></span>
      </a>
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container steps-wrap">
    <div class="section-head center">
      <span class="section-eyebrow">Simples e transparente</span>
      <h2>Como funciona o aluguel</h2>
    </div>
    <div class="steps-grid">
      <div class="step-card"><span class="step-num">1</span><span class="step-icon"><%- include('../partials/icons', { icon: 'search' }) %></span><h3>Encontre</h3><p>Pesquise por tipo, cidade e faixa de preço e escolha os imóveis que mais combinam com você.</p></div>
      <div class="step-card"><span class="step-num">2</span><span class="step-icon"><%- include('../partials/icons', { icon: 'chat' }) %></span><h3>Fale com o corretor</h3><p>Envie sua solicitação e tire dúvidas pelo chat exclusivo ou WhatsApp. Você recebe um protocolo para acompanhar tudo.</p></div>
      <div class="step-card"><span class="step-num">3</span><span class="step-icon"><%- include('../partials/icons', { icon: 'calendar' }) %></span><h3>Visite</h3><p>Agende a visita no melhor horário para você e conheça o imóvel pessoalmente.</p></div>
      <div class="step-card"><span class="step-num">4</span><span class="step-icon"><%- include('../partials/icons', { icon: 'key' }) %></span><h3>Assine e mude</h3><p>Análise de documentos ágil, contrato digital e as chaves na sua mão.</p></div>
    </div>
  </div>
</section>

<% if (latest.length) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="section-eyebrow">Novidades</span>
        <h2>Adicionados recentemente</h2>
      </div>
      <a href="/imoveis?ordem=recentes" class="btn btn-outline">Ver todos <%- include('../partials/icons', { icon: 'arrow' }) %></a>
    </div>
    <div class="prop-grid">
      <% for (const p of latest) { %><%- include('../partials/property-card', { p }) %><% } %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container cta-banner">
    <div>
      <h2>Não encontrou o que procura?</h2>
      <p>Conte para o nosso time o que você precisa e avisamos assim que surgir um imóvel com o seu perfil.</p>
    </div>
    <div class="cta-actions">
      <a href="/contato" class="btn btn-light btn-lg"><%- include('../partials/icons', { icon: 'mail' }) %> Enviar mensagem</a>
      <a href="<%= utils.whatsappLink(settings.whatsapp, settings.whatsapp_message) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg"><%- include('../partials/icons', { icon: 'whatsapp' }) %> WhatsApp</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
