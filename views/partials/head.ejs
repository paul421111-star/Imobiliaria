<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? title + ' · ' + settings.site_name : settings.site_name + ' · ' + settings.site_tagline %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : settings.hero_subtitle %>">
  <meta name="theme-color" content="#0f1b33">
  <meta property="og:site_name" content="<%= settings.site_name %>">
  <meta property="og:title" content="<%= title ? title + ' · ' + settings.site_name : settings.site_name %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : settings.hero_subtitle %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/static/img/logo.png' %>">
  <link rel="icon" href="/static/img/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/static/img/logo-mark.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css?v=<%= v %>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<div class="page-progress" id="pageProgress" aria-hidden="true"></div>
