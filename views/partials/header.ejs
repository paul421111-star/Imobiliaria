<header class="site-header <%= typeof headerTransparent !== 'undefined' && headerTransparent ? 'is-transparent' : '' %>" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="<%= settings.site_name %>">
      <span class="brand-mark"><%- include('icons', { icon: 'home' }) %></span>
      <span class="brand-text"><%= settings.site_name %></span>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Início</a>
      <a href="/imoveis" class="<%= currentPath.startsWith('/imov') ? 'active' : '' %>">Imóveis</a>
      <a href="/sobre" class="<%= currentPath === '/sobre' ? 'active' : '' %>">Sobre</a>
      <a href="/contato" class="<%= currentPath === '/contato' ? 'active' : '' %>">Contato</a>
      <a href="/acompanhar" class="<%= currentPath.startsWith('/acompanhar') ? 'active' : '' %>">
        <%- include('icons', { icon: 'file' }) %> Acompanhar solicitação
      </a>
    </nav>
    <div class="header-actions">
      <a class="btn btn-whatsapp btn-sm" href="<%= utils.whatsappLink(settings.whatsapp, settings.whatsapp_message) %>" target="_blank" rel="noopener">
        <%- include('icons', { icon: 'whatsapp' }) %> <span>WhatsApp</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false"><%- include('icons', { icon: 'menu' }) %></button>
    </div>
  </div>
</header>
<% if (flash) { %>
<div class="container"><div class="alert alert-<%= flash.type %> alert-floating" role="status"><%- include('icons', { icon: flash.type === 'success' ? 'check' : 'info' }) %><span><%= flash.text %></span><button class="alert-close" aria-label="Fechar" onclick="this.parentElement.remove()">&times;</button></div></div>
<% } %>
