<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand brand-light" aria-label="<%= settings.site_name %>">
        <img src="/static/img/logo-light.png" alt="<%= settings.site_name %>" class="brand-logo brand-logo-lg" width="570" height="420">
      </a>
      <p><%= settings.about %></p>
      <div class="social-links">
        <% const socials = [['instagram','Instagram'],['facebook','Facebook'],['tiktok','TikTok'],['youtube','YouTube'],['linkedin','LinkedIn']]; %>
        <% for (const [key, label] of socials) { if (settings[key]) { %>
          <a href="<%= settings[key] %>" target="_blank" rel="noopener" aria-label="<%= label %>" title="<%= label %>" class="social-<%= key %>"><%- include('icons', { icon: key }) %></a>
        <% } } %>
        <a href="<%= utils.whatsappLink(settings.whatsapp, settings.whatsapp_message) %>" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp" class="social-whatsapp"><%- include('icons', { icon: 'whatsapp' }) %></a>
      </div>
    </div>
    <div>
      <h4>Navegação</h4>
      <ul>
        <li><a href="/imoveis">Todos os imóveis</a></li>
        <li><a href="/imoveis?tipo=apartamento">Apartamentos</a></li>
        <li><a href="/imoveis?tipo=casa">Casas</a></li>
        <li><a href="/imoveis?tipo=comercial">Comercial</a></li>
        <li><a href="/acompanhar">Acompanhar solicitação</a></li>
      </ul>
    </div>
    <div>
      <h4>Institucional</h4>
      <ul>
        <li><a href="/sobre">Sobre nós</a></li>
        <li><a href="/contato">Fale conosco</a></li>
        <li><a href="/sobre#requisitos">Requisitos para alugar</a></li>
        <li><a href="/admin/login" rel="nofollow">Área do corretor</a></li>
      </ul>
    </div>
    <div>
      <h4>Contato</h4>
      <ul class="contact-list">
        <% if (settings.phone) { %><li><%- include('icons', { icon: 'phone' }) %> <a href="tel:<%= settings.phone.replace(/\D/g,'') %>"><%= settings.phone %></a></li><% } %>
        <% if (settings.whatsapp) { %><li><%- include('icons', { icon: 'whatsapp' }) %> <a href="<%= utils.whatsappLink(settings.whatsapp, settings.whatsapp_message) %>" target="_blank" rel="noopener"><%= utils.formatPhone(settings.whatsapp.replace(/^55/, '')) %></a></li><% } %>
        <% if (settings.email) { %><li><%- include('icons', { icon: 'mail' }) %> <a href="mailto:<%= settings.email %>"><%= settings.email %></a></li><% } %>
        <% if (settings.address) { %><li><%- include('icons', { icon: 'pin' }) %> <span><%= settings.address %></span></li><% } %>
        <% if (settings.business_hours) { %><li><%- include('icons', { icon: 'clock' }) %> <span><%= settings.business_hours %></span></li><% } %>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= settings.site_name %>. <%= settings.footer_text %></span>
  </div>
</footer>

<button class="back-top" id="backTop" aria-label="Voltar ao topo" type="button"><%- include('icons', { icon: 'arrow' }) %></button>

<div class="wa-widget" id="waWidget">
  <div class="wa-popup" id="waPopup" hidden>
    <div class="wa-popup-head">
      <span class="wa-avatar"><img src="/static/img/logo-mark.png" alt=""><i class="wa-online"></i></span>
      <div><strong><%= settings.site_name %></strong><span>Normalmente responde em minutos</span></div>
      <button type="button" class="wa-close" id="waClose" aria-label="Fechar"><%- include('icons', { icon: 'close' }) %></button>
    </div>
    <div class="wa-popup-body">
      <div class="wa-bubble">Olá! 👋 Que bom ter você por aqui.<br>Como posso ajudar com o seu próximo imóvel?</div>
      <textarea id="waMessage" rows="2" placeholder="Escreva sua mensagem..."><%= typeof waPrefill !== 'undefined' && waPrefill ? waPrefill : settings.whatsapp_message %></textarea>
      <a href="<%= utils.whatsappLink(settings.whatsapp, settings.whatsapp_message) %>" id="waSend" class="btn btn-whatsapp btn-block" target="_blank" rel="noopener" data-phone="<%= settings.whatsapp.replace(/\D/g,'') %>"><%- include('icons', { icon: 'whatsapp' }) %> Iniciar conversa</a>
    </div>
  </div>
  <button type="button" class="whatsapp-float" id="waToggle" aria-label="Falar no WhatsApp" aria-expanded="false">
    <span class="wa-pulse" aria-hidden="true"></span>
    <%- include('icons', { icon: 'whatsapp' }) %>
    <span class="wa-label">Fale conosco</span>
  </button>
</div>

<div class="cookie-bar" id="cookieBar" hidden role="dialog" aria-live="polite">
  <p><%- include('icons', { icon: 'shield' }) %> Usamos cookies essenciais para o funcionamento do site e para lembrar suas solicitações. Ao continuar navegando, você concorda com isso.</p>
  <button type="button" class="btn btn-accent btn-sm" id="cookieOk">Entendi</button>
</div>

<script src="/static/js/site.js?v=<%= v %>" defer></script>
<% if (typeof extraScripts !== 'undefined') { %><%- extraScripts %><% } %>
</body>
</html>
